#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: nosharesock + multichannel across two shares on same host
#
# Behavior under test
# - With -o nosharesock,multichannel,max_channels=2, mounting two different
#   shares on the same host should create two separate connections, each with
#   2 allocated channels reported in DebugData. TCP sockets to the server
#   should be >= 4 in total.
#
# Skip policy
# - Requires a second share on the same host via SCRATCH_DEV (preferred) or
#   TEST_DEV2. Skips if not available or if DebugData lacks interface info.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_debug

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

pick_second_share() {
    local primary="$1" candidate host share
    local primary_host primary_share
    primary_host=$(_host_from_unc "$primary")
    primary_share=$(_share_from_unc "$primary")
    for candidate in "$SCRATCH_DEV" "$TEST_DEV2"; do
        [[ "$candidate" =~ ^//[^/]+/[^/]+ ]] || continue
        host=$(_host_from_unc "$candidate")
        share=$(_share_from_unc "$candidate")
        [ "${host,,}" = "${primary_host,,}" ] || continue
        [ -n "$share" ] && [ "${share,,}" != "${primary_share,,}" ] || continue
        printf '%s\n' "$candidate"
        return 0
    done
    return 1
}

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_share_from_unc() { echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#'; }
_unc_windows() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "\\\\%s\\%s" "$h" "$s"; }
_unc_posix() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "//%s/%s" "$h" "$s"; }

PRIMARY="$TEST_DEV"
SECONDARY=$(pick_second_share "$PRIMARY")
[ -n "$SECONDARY" ] || _notrun "need second share on same host in SCRATCH_DEV or TEST_DEV2"

HOST1=$(_host_from_unc "$PRIMARY")
HOST2=$(_host_from_unc "$SECONDARY")
[ "${HOST1,,}" = "${HOST2,,}" ] || _notrun "both shares must be on same host"
HOST="$HOST1"
SHARE1=$(_share_from_unc "$PRIMARY")
SHARE2=$(_share_from_unc "$SECONDARY")
UNC1=$(_unc_windows "$PRIMARY"); UNC2=$(_unc_windows "$SECONDARY")
UNC1_FS=$(_unc_posix "$PRIMARY"); UNC2_FS=$(_unc_posix "$SECONDARY")
[ "$UNC1" != "$UNC2" ] || _notrun "shares must be different"

command -v ss >/dev/null 2>&1 || _notrun "ss required"
[ -r /proc/fs/cifs/DebugData ] || _notrun "DebugData unavailable"
. ./common/cifs_test
_cifs_test_init

# Mount both shares with nosharesock + multichannel + max_channels=2
_cifs_test_mount_connection 'vers=3.1.1,multichannel,max_channels=2' "$PRIMARY"
primary_connection=$CIFS_TEST_CONNECTION
_cifs_test_workspace "$CIFS_TEST_MNT"
first=$CIFS_TEST_WORK
_cifs_test_mount_connection 'vers=3.1.1,multichannel,max_channels=2' "$SECONDARY"
secondary_connection=$CIFS_TEST_CONNECTION
_cifs_test_workspace "$CIFS_TEST_MNT"
second=$CIFS_TEST_WORK

# Light I/O
echo primary > "$first/data" || _fail "create primary file failed"
echo secondary > "$second/data" || _fail "create secondary file failed"
[ "$(cat "$first/data")" = primary ] || _fail "primary data mismatch"
[ "$(cat "$second/data")" = secondary ] || _fail "secondary data mismatch"

# Poll DebugData for two ConnectionId blocks for host with per-connection sum==2
_cifs_wait_multichannel "$PRIMARY" 2 "$primary_connection"
[ "$CIFS_CHANNELS" -eq 2 ] && [ "$CIFS_NOSHARESOCK" -eq 1 ] || _fail "primary connection options not honored"
primary_connection=$CIFS_CONNECTION
interface_ips=$CIFS_INTERFACE_IPS
_cifs_wait_multichannel "$SECONDARY" 2 "$secondary_connection"
[ "$CIFS_CHANNELS" -eq 2 ] && [ "$CIFS_NOSHARESOCK" -eq 1 ] || _fail "secondary connection options not honored"
[ "$primary_connection" != "$CIFS_CONNECTION" ] || _fail "nosharesock mounts share a connection"
interface_ips="$interface_ips,$CIFS_INTERFACE_IPS"

# Also verify sockets >= 4
tries=20
sc=0
while [ $tries -gt 0 ]; do
    sc=$(_cifs_tcp_connections "$HOST" "$interface_ips")
    echo "sockets: count=$sc (tries=$tries)" >> $seqres.full
    [ "$sc" -ge 4 ] && break
    tries=$((tries-1)); sleep 0.3
done
[ "$sc" -ge 4 ] || _fail "expected >=4 TCP sockets to $HOST with two nosharesock multichannel mounts (got $sc)"

echo "Nosharesock multichannel (2 mounts * 2 channels) OK"

status=0
exit
