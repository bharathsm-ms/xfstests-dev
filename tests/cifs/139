#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: nosharesock uses separate sockets per mount (DebugData sessions)

. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_debug

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -r /proc/fs/cifs/DebugData ] || _notrun "requires DebugData"

M1=""
M2=""
M1_MOUNTED=false
M2_MOUNTED=false
_cleanup_139() {
    if $M2_MOUNTED; then
        umount "$M2" >> "$seqres.full" 2>&1 || status=1
    fi
    if $M1_MOUNTED; then
        umount "$M1" >> "$seqres.full" 2>&1 || status=1
    fi
    [ -z "$M2" ] || rmdir "$M2" >> "$seqres.full" 2>&1 || status=1
    [ -z "$M1" ] || rmdir "$M1" >> "$seqres.full" 2>&1 || status=1
    _cleanup
}
_register_cleanup _cleanup_139

BASE=$(echo "${MOUNT_OPTIONS:-}" | sed -e 's/^\s*-o\s*//')
BASE=$(printf '%s\n' "$BASE" | awk -F, '{ for (field=1; field<=NF; field++) { if ($field=="nosharesock" || $field=="sharesock") continue; options=options (options ? "," : "") $field } print options }')
MO_SH=$BASE
MO_NS="${BASE:+$BASE,}nosharesock"

M1=$(mktemp -d /tmp/cifs139.sh.XXXXXX) || _fail "mktemp1"
M2=$(mktemp -d /tmp/cifs139.ns.XXXXXX) || _fail "mktemp2"

_do "mount -t cifs '$TEST_DEV' '$M1' -o '$MO_SH'" || _fail "mount shared"
M1_MOUNTED=true
mid_ids=$(_cifs_debug_share "$TEST_DEV" | awk '$1!="-" {print $1}' | sort -u)
echo "cifs139: mid_ids=$(echo "$mid_ids" | tr '\n' ' ')" >> $seqres.full
[ -n "$mid_ids" ] || _notrun "cannot observe target share in DebugData"
_do "mount -t cifs '$TEST_DEV' '$M2' -o '$MO_NS'" || _fail "mount nosharesock"
M2_MOUNTED=true

after_ids=$(_cifs_debug_share "$TEST_DEV" | awk '$6==1 && $1!="-" {print $1}' | sort -u)
echo "cifs139: after_ids=$(echo "$after_ids" | tr '\n' ' ')" >> $seqres.full
[ -n "$after_ids" ] || _notrun "DebugData parse error"

new_after=$(comm -13 <(printf '%s\n' "$mid_ids") <(printf '%s\n' "$after_ids") | grep -c .)

[ "$new_after" -eq 1 ] || _fail "nosharesock did not create exactly one new target ConnectionId"

echo "nosharesock creates separate sockets OK"

status=0
exit
