#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: resilience of reads, directory ops, and metadata across reconnects
#
# Summary
#   Extends sequential write coverage (cifs/184) by forcing TCP disconnects
#   during three additional operation classes—large sequential reads,
#   directory churn, and metadata updates—and ensuring each operation family
#   completes successfully with consistent end state.
#
# Phases
#   1. Prepare deterministic data and helpers.
#   2. Launch a large reader, drop connectivity mid-stream, verify it
#      completes and the file hash matches original content.
#   3. Run directory rename churn while dropping connectivity, confirm final
#      inventory matches expectation.
#   4. Toggle metadata (mode + mtime) in a loop whilst dropping connectivity,
#      then ensure the final metadata matches the planned target.

. ./common/preamble
. ./common/rc
_begin_fstest auto stress

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/DebugData ] || _notrun "DebugData unavailable"

mount_opts=$(awk -v mnt="$TEST_DIR" '$2==mnt {print $4; exit}' /proc/mounts)

. ./common/cifs_test
_cifs_test_init
command -v python3 >/dev/null || _notrun "python3 required"
command -v ss >/dev/null || _notrun "ss required"
READ_MB=${CIFS192_READ_MB:-8}
DIR_FILES=${CIFS192_DIR_FILES:-20}
META_LOOPS=${CIFS192_META_LOOPS:-20}
for value in "$READ_MB" "$DIR_FILES" "$META_LOOPS"; do
    [[ "$value" =~ ^[1-9][0-9]*$ ]] && [ "$value" -le 128 ] || _notrun "workload sizes must be integers from 1 to 128"
done
_cifs_test_socket_snapshot > "$tmp.before"
mode_option=cifsacl
case ",$mount_opts," in *,modefromsid,*) mode_option=modefromsid ;; esac
_cifs_test_mount "vers=3.1.1,cache=none,actimeo=0,nomultichannel,echo_interval=1,$mode_option"
_cifs_test_mount_option "$mode_option"
_cifs_test_workspace "$CIFS_TEST_MNT"
timeout --kill-after=5s 120 python3 - "$CIFS_TEST_WORK" "$tmp" "$READ_MB" "$DIR_FILES" "$META_LOOPS" >> "$seqres.full" 2>&1 <<'PY' &
import os, stat, sys, time
from pathlib import Path
root = Path(sys.argv[1])
barrier = sys.argv[2]
megabytes, files, loops = map(int, sys.argv[3:])
def pause(phase):
    Path(f'{barrier}.ready-{phase}').touch()
    deadline = time.monotonic() + 30
    while not Path(f'{barrier}.go-{phase}').exists():
        assert time.monotonic() < deadline, 'reconnect barrier timeout'
        time.sleep(0.02)
expected = bytes(range(256)) * (megabytes * 4096)
target = root / 'data'
with target.open('wb', buffering=0) as output:
    assert output.write(expected) == len(expected)
    os.fsync(output.fileno())
with target.open('rb', buffering=0) as source:
    midpoint = len(expected) // 2
    assert source.read(midpoint) == expected[:midpoint]
    pause(1)
    assert source.read() == expected[midpoint:]
first, second = root / 'first', root / 'second'
first.mkdir()
second.mkdir()
for number in range(files):
    assert (first / str(number)).write_text(f'payload-{number}') == len(f'payload-{number}')
for number in range(files):
    (first / str(number)).rename(second / str(number))
    if number == files // 2:
        pause(2)
for number in range(files):
    (second / str(number)).rename(first / f'renamed-{number}')
assert not list(second.iterdir())
assert set(os.listdir(first)) == {f'renamed-{number}' for number in range(files)}
for number in range(files):
    assert (first / f'renamed-{number}').read_text() == f'payload-{number}'
metadata = root / 'metadata'
assert metadata.write_bytes(b'metadata-data') == 13
for number in range(loops):
    mode = 0o640 if number % 2 == 0 else 0o600
    metadata.chmod(mode)
    os.utime(metadata, (1700000000 + number, 1700000000 + number))
    if number == loops // 2:
        pause(3)
info = metadata.stat()
assert stat.S_IMODE(info.st_mode) == mode
assert info.st_mtime_ns == (1700000000 + loops - 1) * 1000000000
assert metadata.read_bytes() == b'metadata-data'
assert target.read_bytes() == expected
PY
worker=$!
_cifs_test_children+=("$worker")
for phase in 1 2 3; do
    for attempt in $(seq 1 500); do
        [ ! -e "$tmp.ready-$phase" ] || break
        kill -0 "$worker" 2>/dev/null || _fail "worker exited before reconnect barrier"
        sleep 0.02
    done
    [ -e "$tmp.ready-$phase" ] || _fail "worker did not reach reconnect barrier"
    _cifs_test_socket_snapshot > "$tmp.after"
    _cifs_test_new_socket "$tmp.before" "$tmp.after"
    _cifs_test_disconnect >> "$seqres.full" 2>&1 || _fail "disconnect test-owned socket failed"
    touch "$tmp.go-$phase" || _fail "release reconnect barrier"
done
_cifs_test_wait

echo "Read, directory, and metadata operations recovered after reconnect OK"
status=0
exit
