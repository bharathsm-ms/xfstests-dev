#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: idsfromsid numeric owner/group SID decoding
#
# Behavior under test
# - Mount with cifsacl,idsfromsid — verify mount succeeds
# - Create a file — check if owner UID is mapped from SID
# - Compare numeric owner/group SIDs from the descriptor with stat IDs
#
# Kernel code exercised
#   sid_to_id(), id_to_sid(), init_cifs_idmap(),
#   cifs_idmap_key_instantiate(), cifs_idmap_key_destroy()

. ./common/preamble
. ./common/rc

_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$CIFS_CRED_FILE" ] || _notrun "CIFS_CRED_FILE not set"

. ./common/cifs_test
_cifs_test_init
command -v python3 >/dev/null || _notrun "python3 required"
_cifs_test_mount 'vers=3.1.1,cifsacl,idsfromsid,actimeo=0'
_cifs_test_workspace "$CIFS_TEST_MNT"
TESTFILE="$CIFS_TEST_WORK/data"
echo idmap-test > "$TESTFILE" || _fail "create file failed"
python3 - "$TESTFILE" >> "$seqres.full" 2>&1 <<'PY'
import os, struct, sys
path = sys.argv[1]
descriptor = os.getxattr(path, 'system.cifs_ntsd')
assert len(descriptor) >= 20
metadata = os.stat(path)
checked = 0
for field, kind, observed in ((4, 1, metadata.st_uid), (8, 2, metadata.st_gid)):
    offset = struct.unpack_from('<I', descriptor, field)[0]
    assert 20 <= offset <= len(descriptor) - 8
    revision, count = struct.unpack_from('BB', descriptor, offset)
    assert revision == 1 and offset + 8 + count * 4 <= len(descriptor)
    authority = int.from_bytes(descriptor[offset+2:offset+8], 'big')
    subauthorities = struct.unpack_from('<' + 'I' * count, descriptor, offset+8)
    numeric = (authority == 22 and count == 2 and subauthorities[0] == kind) or (
        authority == 5 and count == 3 and subauthorities[:2] == (88, kind))
    if numeric:
        assert observed == subauthorities[-1], 'numeric SID did not map to its embedded ID'
        checked += 1
        print('verified numeric SID kind', kind, 'ID', observed)
sys.exit(0 if checked else 77)
PY
result=$?
[ "$result" -ne 77 ] || _notrun "fixture owner/group lack numeric Unix SIDs"
[ "$result" -eq 0 ] || _fail "numeric SID mapping mismatch"

# ── No crash check ────────────────────────────────────────────
dmesg_check=$(dmesg | tail -10)
if echo "$dmesg_check" | grep -qiE 'BUG:|kernel panic|Oops:'; then
	_fail "kernel crash during idmap test"
fi

echo "idsfromsid SID-to-UID mapping OK"

status=0
exit
