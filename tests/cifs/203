#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: leverage cifscreds for multiuser mounts and enforce credential fallback
#
# Behavior under test:
# - Authenticate secondary-UID I/O using a private cifscreds keyring.
# - Clear the credential and require denied access on a fresh multiuser mount.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick auth

. ./common/cifs_test
_cifs_test_init
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -r "${CIFS_CRED_FILE2:-}" ] || _notrun "CIFS_CRED_FILE2 required for a distinct server account"
command -v python3 >/dev/null 2>&1 || _notrun "python3 required"
command -v cifscreds >/dev/null 2>&1 || _notrun "cifscreds utility required"
command -v keyctl >/dev/null || _notrun "keyctl required"
command -v setpriv >/dev/null || _notrun "setpriv required"
[[ "${CIFS_MULTIUSER_UID:-}" =~ ^[1-9][0-9]*$ ]] || _notrun "dedicated non-root CIFS_MULTIUSER_UID required"
group=$(id -g "$CIFS_MULTIUSER_UID") || _notrun "dedicated credential UID does not exist"
options="vers=3.1.1,multiuser,sec=ntlmssp,cache=none,uid=0,gid=$group,file_mode=0660,dir_mode=0770"
_cifs_test_mount "$options"
_cifs_test_mount_option multiuser
_cifs_test_workspace "$CIFS_TEST_MNT"
positive=$CIFS_TEST_WORK
chmod 0777 "$positive" || _fail "allow worker access to owned workspace"
_cifs_test_mount "$options"
_cifs_test_mount_option multiuser
negative="$CIFS_TEST_MNT/${positive##*/}/file"
timeout --kill-after=5s 90 python3 - "$CIFS_CRED_FILE2" "$TEST_DEV" "$positive/file" "$negative" "$CIFS_MULTIUSER_UID" "$group" >> "$seqres.full" 2>&1 <<'PY'
import configparser, json, socket, subprocess, sys
from pathlib import Path
settings = configparser.ConfigParser(interpolation=None)
settings.read_string('[credentials]\n' + Path(sys.argv[1]).read_text())
credentials = settings['credentials']
username = credentials.get('username', credentials.get('user', ''))
password = credentials.get('password', credentials.get('pass', ''))
assert username and password and '\n' not in password and '\r' not in password
username = username.rsplit('\\', 1)[-1]
addresses = {entry[4][0] for entry in socket.getaddrinfo(sys.argv[2].split('/')[2], 445, socket.AF_INET, socket.SOCK_STREAM)}
if len(addresses) != 1:
    sys.exit(77)
worker = r'''
import errno, json, os, pty, select, signal, subprocess, sys, termios, time
from pathlib import Path
username, password, address, positive, negative = json.load(sys.stdin)
def search():
    return subprocess.run(['keyctl', 'search', '@s', 'logon', 'cifs:a:' + address], capture_output=True)
assert search().returncode != 0, 'private keyring already contains a credential'
child, master = pty.fork()
if child == 0:
    os.execvp('cifscreds', ['cifscreds', 'add', '-u', username, address])
completed = False
sent = False
received = b''
try:
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        ready, ignored, errors = select.select([master], [], [], 0.05)
        if ready:
            try:
                data = os.read(master, 4096)
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
                data = b''
            received = (received + data)[-4096:]
            if not sent and b'password' in received.lower():
                assert not termios.tcgetattr(master)[3] & termios.ECHO
                secret = password.encode() + b'\n'
                assert os.write(master, secret) == len(secret)
                sent = True
        waited, status = os.waitpid(child, os.WNOHANG)
        if waited:
            completed = True
            assert sent and os.waitstatus_to_exitcode(status) == 0, 'cifscreds add failed'
            break
    assert completed, 'cifscreds prompt timed out'
finally:
    if not completed:
        os.kill(child, signal.SIGKILL)
        os.waitpid(child, 0)
    os.close(master)
assert search().returncode == 0, 'credential not found in private keyring'
path = Path(positive)
assert path.write_bytes(b'cred test\n') == 10
assert path.read_bytes() == b'cred test\n'
subprocess.run(['cifscreds', 'clear', address], check=True, capture_output=True, timeout=15)
assert search().returncode != 0, 'clear left a credential in the private keyring'
try:
    Path(negative).read_bytes()
except OSError as error:
    assert error.errno in (errno.EACCES, errno.ENOKEY), 'unexpected failure after credential removal'
else:
    raise AssertionError('fresh multiuser access succeeded without a credential')
'''
process = subprocess.run(['setpriv', '--reuid=' + sys.argv[5], '--regid=' + sys.argv[6], '--clear-groups',
                          'keyctl', 'session', '-', sys.executable, '-c', worker],
                         input=json.dumps([username, password, next(iter(addresses)), sys.argv[3], sys.argv[4]]),
                         text=True, capture_output=True, timeout=75)
assert process.returncode == 0, 'private credential authentication or negative control failed: ' + process.stderr
PY
result=$?
[ "$result" -ne 77 ] || _notrun "single IPv4 address required for cifscreds fixture"
[ "$result" -eq 0 ] || _fail "multiuser credential authentication/denial failed"
[ "$(cat "$negative")" = "cred test" ] || _fail "root control read failed after credential removal"

echo "cifs203: cifscreds multiuser mount OK"

status=0
exit
