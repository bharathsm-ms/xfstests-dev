#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: lease reclaim after TCP reconnect
#
# Goal:
#   Open a batch of files to obtain RWH (or RH) leases, forcibly drop TCP
#   connectivity (iptables DROP) to simulate a disconnect, remove DROP rules,
#   then verify lease entries for all files reappear in /proc/fs/cifs/open_files
#   within a recovery window and are not downgraded collectively to no lease.
#
# Acceptance:
#   - Initial: at least N files show lease tokens (RWH/RH/RW). If too few, skip.
#   - After reconnect: same count of files have lease tokens (token may be RH instead of RWH) within timeout.
#
# Skip conditions:
#   - Not CIFS, missing TEST_DIR
#   - /proc/fs/cifs/open_files unavailable
#   - No leasing capability (cap bit 0x2)
#   - Not root or missing iptables
#
# Output: single success line.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/open_files ] || _notrun "no open_files interface"
[ -r /proc/fs/cifs/DebugData ] || _notrun "no DebugData"
[ "$(id -u)" = 0 ] || _notrun "root required for iptables"
command -v iptables >/dev/null 2>&1 || _notrun "iptables missing"

host=$(echo "$TEST_DEV" | sed -E 's#^//([^/]+)/.*#\1#')
[ -n "$host" ] || _notrun "parse host failed"
cap_line=$(awk -v h="$host" 'tolower($0) ~ h {t=1} t && /Server capabilities:/ {print; exit}' /proc/fs/cifs/DebugData)
[ -n "$cap_line" ] || _notrun "no capabilities line"
cap_hex=$(echo "$cap_line" | sed -n 's/.*Server capabilities:[[:space:]]*0x\([0-9a-fA-F]\+\).*/\1/p')
[ -n "$cap_hex" ] || _notrun "parse caps failed"
cap_val=$((0x$cap_hex))
if [ $((cap_val & 0x2)) -eq 0 ]; then _notrun "leasing unsupported"; fi

server_ip=$(getent ahostsv4 "$host" | awk '{print $1; exit}')
[ -n "$server_ip" ] || _notrun "resolve server ip failed"

NUM=${CIFS_LEASE_RECLAIM_FILES:-40}
[[ "$NUM" =~ ^[1-9][0-9]*$ ]] || _notrun "CIFS_LEASE_RECLAIM_FILES must be positive"
DIR=$(mktemp -d "$TEST_DIR/cifs172.XXXXXX") || _fail "mkdir"
FILE_PREFIX="${DIR##*/}.f"
required=$(((NUM + 1) / 2))
FILE_FDS=()
OUTPUT_DROPPED=false
INPUT_DROPPED=false
output_rule=(-d "$server_ip" -p tcp --dport 445 -m comment --comment "${DIR##*/}" -j DROP)
input_rule=(-s "$server_ip" -p tcp --sport 445 -m comment --comment "${DIR##*/}" -j DROP)
_cleanup_172() {
    $OUTPUT_DROPPED && iptables -D OUTPUT "${output_rule[@]}" 2>/dev/null
    $INPUT_DROPPED && iptables -D INPUT "${input_rule[@]}" 2>/dev/null
    local open_fd
    for open_fd in "${FILE_FDS[@]}"; do
        exec {open_fd}>&-
    done
    rm -rf "$DIR" >/dev/null 2>&1
    _cleanup
}
_register_cleanup _cleanup_172

# Create and open files
for i in $(seq 1 $NUM); do
    f="$DIR/$FILE_PREFIX$i"
    exec {fd}<>"$f" || _fail "open f$i"
    FILE_FDS+=("$fd")
    printf "x" >&$fd || _fail "write f$i"
done

collect() {
    awk -v pid="$$" -v prefix="$FILE_PREFIX" -v count="$NUM" '
        $6 == pid && index($8, prefix) == 1 && $9 ~ /^[RHW]+$/ {
            number = substr($8, length(prefix) + 1)
            if (number ~ /^[1-9][0-9]*$/ && number + 0 <= count && !seen[$8]++)
                print $8, $9
        }
    ' /proc/fs/cifs/open_files
}

count_leases() {
    awk 'NF { count++ } END { print count+0 }'
}

# Wait for leases
retry=25
have=0
while [ $retry -gt 0 ]; do
    lines=$(collect)
    have=$(printf '%s\n' "$lines" | count_leases)
    [ "$have" -ge "$required" ] && break
    sleep 0.2; retry=$((retry-1))
done
echo "cifs172: initial_lease_entries=$have expected=$NUM" >> $seqres.full
[ "$have" -ge "$required" ] || _notrun "insufficient initial leases ($have)"

# Snapshot baseline map
echo "$lines" > "$DIR/base.map"

# Drop traffic
iptables -I OUTPUT "${output_rule[@]}" 2>>$seqres.full || _notrun "iptables OUTPUT rule fail"
OUTPUT_DROPPED=true
iptables -I INPUT "${input_rule[@]}" 2>>$seqres.full || _notrun "iptables INPUT rule fail"
INPUT_DROPPED=true
sleep 3
iptables -D OUTPUT "${output_rule[@]}" 2>>$seqres.full || _fail "remove OUTPUT rule failed"
OUTPUT_DROPPED=false
iptables -D INPUT "${input_rule[@]}" 2>>$seqres.full || _fail "remove INPUT rule failed"
INPUT_DROPPED=false

# Recovery: wait for lease reappearance (equal or near baseline count)
retry=40
post=0
while [ $retry -gt 0 ]; do
    lines2=$(collect)
    post=$(printf '%s\n' "$lines2" | count_leases)
    echo "cifs172: recovery poll count=$post retry=$retry" >> $seqres.full
    [ "$post" -ge "$have" ] && break
    sleep 0.25; retry=$((retry-1))
done
[ "$post" -ge "$have" ] || _fail "lease entries not fully recovered (baseline=$have recovered=$post)"

echo "Lease reclaim after reconnect OK"
status=0; exit
