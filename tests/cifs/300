#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: write beyond max offset / huge seek
#
# Negative test: seeking to an absurdly large offset and attempting to
# write should fail with EFBIG or EINVAL, not crash.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

command -v python3 >/dev/null 2>&1 || _notrun "requires python3"

W="$TEST_DIR/cifs300.$$"
_register_cleanup "rm -rf '$W' >/dev/null 2>&1 || true"
mkdir -p "$W" || _fail "mkdir workspace"

F="$W/bigseek"
echo "x" > "$F" || _fail "create file"

python3 -u - "$F" >> "$seqres.full" 2>&1 <<'PYEOF'
import os, sys, errno

filepath = sys.argv[1]
failures = 0

# Test 1: seek to near-max offset (2^63 - 2) then write
fd = os.open(filepath, os.O_RDWR)
rejected = False
expected_errors = (errno.EFBIG, errno.EINVAL)
try:
    huge_offset = (1 << 63) - 2  # near LLONG_MAX
    try:
        os.lseek(fd, huge_offset, os.SEEK_SET)
        if os.write(fd, b"X") != 1:
            raise RuntimeError('short write at huge offset')
        os.fsync(fd)
    except OSError as error:
        if error.errno not in expected_errors:
            raise
        rejected = True
        print(f'huge offset rejected with errno {error.errno}')
finally:
    try:
        os.close(fd)
    except OSError as error:
        if error.errno not in expected_errors:
            raise
        rejected = True
if not rejected:
    raise RuntimeError('huge-offset write/fsync unexpectedly succeeded')

# The huge-offset test closed fd above, so open a fresh descriptor to exercise
# negative seek; reusing the closed fd would only ever return EBADF.
fd = os.open(filepath, os.O_RDWR)
try:
    os.lseek(fd, -1, os.SEEK_SET)
    print("FAIL: negative seek succeeded")
    failures += 1
except OSError as error:
    if error.errno != errno.EINVAL:
        raise
    print('negative seek rejected with EINVAL')
finally:
    os.close(fd)

sys.exit(failures)
PYEOF

rc=$?
[ $rc -eq 0 ] || _fail "write-beyond-max-offset: $rc failures"

# Check no kernel crash
dmesg_tail=$(dmesg | tail -20)
if echo "$dmesg_tail" | grep -qiE 'BUG:|kernel panic|Oops:|RIP:'; then
    _fail "kernel oops after huge offset write"
fi

echo "write beyond max offset OK"

status=0
exit
