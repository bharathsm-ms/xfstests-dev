#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: nohandlecache functional validation
#
# Behavior under test
# - Mount normally and verify cached dir handles appear in /proc/fs/cifs/open_dirs
#   after readdir. Then mount with -o nohandlecache and verify open_dirs stays
#   empty after the same readdir pattern.
# - Fallback: if open_dirs is unavailable, use Stats Creates counter to compare
#   handle reuse between cached and uncached modes.
# - Skip if neither open_dirs nor Stats are available, or if the server doesn't
#   grant directory leases (open_dirs empty even without nohandlecache).

. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_debug
. ./common/cifs_test
_cifs_test_init

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_unc_windows() {
    local h=$(_host_from_unc "$1")
    local s=$(echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#')
    printf "\\\\%s\\%s" "$h" "$s"
}
UNCW=$(_unc_windows "$TEST_DEV")

OPEN_DIRS="/proc/fs/cifs/open_dirs"
have_open_dirs=false
[ -r "$OPEN_DIRS" ] && have_open_dirs=true

_stats_creates() {
    _cifs_stat "$TEST_DEV" "Creates:"
}

_open_dirs_count() {
    local session
    session=$(_cifs_debug_share "$TEST_DEV" | awk -v connection="$CIFS_TEST_CONNECTION" '$1 == connection {print $2}')
    awk -v session="$session" -v path="${W##*/}" '
        $2==session && $1 ~ /^0x/ {
            name=$5; gsub(/\\/, "/", name); sub(/^\/+/, "", name)
            if (name==path) count++
        }
        END { print count+0 }
    ' "$OPEN_DIRS"
}

_readdir_232() {
    LC_ALL=C ls -1 "$W" > "$tmp.listing" || _fail "readdir failed"
    cmp "$tmp.expected" "$tmp.listing" || _fail "directory inventory mismatch"
}
printf 'f1\nf2\nf3\nf4\nf5\n' > "$tmp.expected" || _fail "prepare directory inventory"

# ============================================================
# Phase 1: Mount normally (with dir handle caching)
# ============================================================
_cifs_test_mount_connection 'vers=3.1.1,actimeo=0'
_cifs_test_workspace "$CIFS_TEST_MNT"
W=$CIFS_TEST_WORK
for i in $(seq 1 5); do echo "f$i" > "$W/f$i" || _fail "create file failed"; done
sync -f "$W" || _fail "sync directory fixture"

# Trigger readdir multiple times to populate cache
for i in $(seq 1 10); do
    _readdir_232
done
sleep 1

cached_dirs=0
if $have_open_dirs; then
    cached_dirs=$(_open_dirs_count "cifs232")
    echo "phase1 (cached): open_dirs entries=$cached_dirs" >> $seqres.full
fi

cr_cached=0
cr0=$(_stats_creates)
if [ -n "$cr0" ]; then
    for i in $(seq 1 5); do _readdir_232; done
    cr1=$(_stats_creates) || _fail "cached Creates counter disappeared"
    cr_cached=$((cr1 - cr0))
    echo "phase1 (cached): stats creates delta=$cr_cached" >> $seqres.full
fi

rm -rf "$W" || _fail "cached fixture cleanup failed"

# ============================================================
# Phase 2: Mount with nohandlecache
# ============================================================
_cifs_test_mount_connection 'vers=3.1.1,actimeo=0,nohandlecache'
_cifs_test_mount_option nohandlecache
_cifs_test_workspace "$CIFS_TEST_MNT"
W=$CIFS_TEST_WORK
for i in $(seq 1 5); do echo "f$i" > "$W/f$i" || _fail "create file failed"; done

# Snapshot open_dirs baseline AFTER nohandlecache mount (stale entries may exist)
nohandle_baseline=0
if $have_open_dirs; then
    nohandle_baseline=$(_open_dirs_count "cifs232")
    echo "phase2 (nohandlecache): open_dirs baseline=$nohandle_baseline" >> $seqres.full
fi

# Trigger readdir multiple times
for i in $(seq 1 10); do
    _readdir_232
done
sleep 1

nohandle_dirs=0
if $have_open_dirs; then
    nohandle_dirs_raw=$(_open_dirs_count "cifs232")
    nohandle_dirs=$nohandle_dirs_raw
    echo "phase2 (nohandlecache): open_dirs entries=$nohandle_dirs_raw baseline=$nohandle_baseline delta=$nohandle_dirs" >> $seqres.full
fi

cr_nohandle=0
cr2=$(_stats_creates)
if [ -n "$cr2" ]; then
    for i in $(seq 1 5); do _readdir_232; done
    cr3=$(_stats_creates) || _fail "uncached Creates counter disappeared"
    cr_nohandle=$((cr3 - cr2))
    echo "phase2 (nohandlecache): stats creates delta=$cr_nohandle" >> $seqres.full
fi

# ============================================================
# Evaluate results
# ============================================================
validated=false

# Method 1: open_dirs check
if $have_open_dirs; then
    if [ "$cached_dirs" -gt 0 ] && [ "$nohandle_dirs" -eq 0 ]; then
        echo "nohandlecache: open_dirs confirms no cached dir handles (cached=$cached_dirs nohandle=$nohandle_dirs)" >> $seqres.full
        validated=true
    elif [ "$cached_dirs" -gt 0 ] && [ "$nohandle_dirs" -gt 0 ]; then
        _fail "nohandlecache: expected 0 cached dirs but found $nohandle_dirs (cached mode had $cached_dirs)"
    else
        echo "open_dirs empty even in cached mode (server may not grant dir leases)" >> $seqres.full
    fi
fi

# Method 2: Stats Creates fallback
if ! $validated && [ -n "$cr0" ] && [ -n "$cr2" ]; then
    if [ "$cr_nohandle" -gt "$cr_cached" ]; then
        echo "nohandlecache: Stats confirms more Creates without caching (nohandle=$cr_nohandle cached=$cr_cached)" >> $seqres.full
        validated=true
    elif [ "$cr_nohandle" -eq "$cr_cached" ]; then
        echo "nohandlecache: same Creates in both modes (server may not cache dirs)" >> $seqres.full
    fi
fi

if ! $validated; then
    _notrun "normal mount showed no directory handle reuse (cached Creates=$cr_cached, nohandlecache Creates=$cr_nohandle)"
fi

echo "nohandlecache functional OK"

status=0
exit
