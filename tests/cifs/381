#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: proc interfaces with an active share and checked debug controls

. ./common/preamble
. ./common/rc

_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$CIFS_CRED_FILE" ] || _notrun "CIFS_CRED_FILE not set"

. ./common/cifs_test
. ./common/cifs_debug
_cifs_test_init
_cifs_test_save_setting /proc/fs/cifs/cifsFYI
_cifs_test_save_setting /proc/fs/cifs/traceSMB
_cifs_test_mount 'vers=3.1.1'
_cifs_test_workspace "$CIFS_TEST_MNT"

share=$(_cifs_debug_share "$TEST_DEV") || _fail "read DebugData"
[ -n "$share" ] || _fail "target absent from DebugData"
before=$(_cifs_stat "$TEST_DEV" Creates:) || _notrun "per-share Creates unavailable"
echo test > "$CIFS_TEST_WORK/data" || _fail "create proc fixture"
[ "$(cat "$CIFS_TEST_WORK/data")" = test ] || _fail "read proc fixture"
after=$(_cifs_stat "$TEST_DEV" Creates:) || _fail "read Creates"
[ "$after" -gt "$before" ] || _fail "Creates did not increase"

for control in cifsFYI traceSMB; do
        value=1
        [ "$control" != cifsFYI ] || value=7
        printf '%s\n' "$value" > "/proc/fs/cifs/$control" || _fail "set $control"
        [ "$(cat "/proc/fs/cifs/$control")" = "$value" ] || _fail "$control readback mismatch"
        printf '%s\n' "$control" > "$CIFS_TEST_WORK/data" || _fail "write with $control"
        [ "$(cat "$CIFS_TEST_WORK/data")" = "$control" ] || _fail "read with $control"
done

for control in SecurityFlags LookupCacheEnabled; do
        value=$(cat "/proc/fs/cifs/$control") || _fail "read $control"
        [ -n "$value" ] || _fail "empty $control"
done

if [ -r /proc/fs/cifs/mount_params ]; then
        grep -q '^vers:' /proc/fs/cifs/mount_params || _fail "mount_params missing vers"
fi

if [ -r /proc/fs/cifs/open_files ]; then
        fixture="proc381_$$"
        exec 9> "$CIFS_TEST_WORK/$fixture" || _fail "open proc fixture"
        grep -Fq "$fixture" /proc/fs/cifs/open_files || _fail "open fixture absent from proc"
        exec 9>&-
fi

echo "Silence is golden"
status=0
exit
