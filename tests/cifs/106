#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: verify SMB3 multichannel activates with multichannel mount option
#
# Behavior under test
# - When mounting with -o multichannel (or max_channels), the client should
#   establish multiple transport connections (>=2) to the server if supported.
# - We detect multichannel via /proc/fs/cifs/DebugData "Server interfaces"
#   Allocated channels sum for our host, and also require multiple TCP sockets
#   to the server (port 445/139) to be present at the same time.
#
# Skip policy
# - If DebugData lacks interface info we retry briefly; ultimately this test
#   fails if multichannel is requested but fewer than two channels are visible
#   in both DebugData and sockets for the server.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_debug

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_share_from_unc() { echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#'; }
_unc_windows() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "\\\\%s\\%s" "$h" "$s"; }
_unc_posix() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "//%s/%s" "$h" "$s"; }

HOST=$(_host_from_unc "$TEST_DEV")
UNCW=$(_unc_windows "$TEST_DEV")
UNCP=$(_unc_posix "$TEST_DEV")
SHARE=$(_share_from_unc "$TEST_DEV")
[ -n "$HOST" ] || _notrun "could not derive host"

command -v ss >/dev/null 2>&1 || _notrun "ss required"
[ -r /proc/fs/cifs/DebugData ] || _notrun "DebugData unavailable"
. ./common/cifs_test
_cifs_test_init

# Ensure we explicitly request multichannel
_cifs_test_mount_connection 'vers=3.1.1,multichannel,max_channels=2'
_cifs_test_workspace "$CIFS_TEST_MNT"

# Light I/O to activate the connection
echo 1 > "$CIFS_TEST_WORK/data" || _fail "create test file failed"
[ "$(cat "$CIFS_TEST_WORK/data")" = 1 ] || _fail "activation data mismatch"

# Poll for DebugData channels (require >=2)
_cifs_wait_multichannel "$TEST_DEV" 2 "$CIFS_TEST_CONNECTION"
sum=$CIFS_CHANNELS

# Also require multiple TCP sockets to the server
tries=20
sc=0
while [ $tries -gt 0 ]; do
    sc=$(_cifs_tcp_connections "$HOST" "$CIFS_INTERFACE_IPS")
    echo "sockets: count=$sc (tries=$tries)" >> $seqres.full
    [ "$sc" -ge 2 ] && break
    tries=$((tries-1)); sleep 0.3
done

[ "$sc" -ge 2 ] || _fail "TCP sockets to $HOST <2 after requesting multichannel (got $sc)"

# Sockets may be fewer than DebugData channel sum when multiple sessions
# share connections or channels span sessions. Log but don't fail.
if [ "$sc" -lt "$sum" ]; then
    echo "note: TCP sockets ($sc) < DebugData allocated channels ($sum) — sessions may share connections" >> $seqres.full
fi

# If max_channels explicitly specified, usually equal to requested; log if not
req=$(echo "$TEST_FS_MOUNT_OPTS $MOUNT_OPTIONS" | sed -n 's/.*max_channels=\([0-9][0-9]*\).*/\1/p' | head -n1)
if [ -n "$req" ] && [ "$req" -ge 2 ]; then
    if [ "$sum" -ne "$req" ]; then
        echo "note: requested max_channels=$req, DebugData shows sum=$sum (server or NIC limit?)" >> $seqres.full
    fi
fi

echo "Multichannel active (>=2 channels) OK"

status=0
exit
