#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: re-resolve a server hostname after resetting an owned TCP connection

. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_test
_cifs_test_init

for required in python3 ss getent; do
  command -v "$required" >/dev/null || _notrun "$required required"
done
host=${TEST_DEV#//}
host=${host%%/*}
python3 - "$host" <<'PY'
import ipaddress, sys
try:
  ipaddress.ip_address(sys.argv[1].strip('[]'))
except ValueError:
  sys.exit(0)
sys.exit(1)
PY
[ "$?" -eq 0 ] || _notrun "hostname re-resolution requires a hostname TEST_DEV"
[ -x "${CIFS149_DNS_HOOK:-}" ] || _notrun "CIFS149_DNS_HOOK required for a dedicated DNS fixture"
[ -n "${CIFS149_SECOND_IP:-}" ] || _notrun "CIFS149_SECOND_IP required"
case "${CIFS149_DNS_HOOK:-}" in /*) ;; *) _notrun "DNS hook must be an absolute executable path" ;; esac

original=$(getent ahostsv4 "$host" | awk '{print $1}' | sort -u)
[[ "$original" =~ ^[0-9.]+$ ]] || _notrun "fixture must initially resolve to exactly one IPv4 address"
[ "$original" != "$CIFS149_SECOND_IP" ] || _notrun "second fixture address must differ"
changed=false
_cleanup_149()
{
  if $changed; then
    timeout --kill-after=5s 20 "$CIFS149_DNS_HOOK" restore "$host" "$original" >> "$seqres.full" 2>&1 || status=1
  fi
  _cifs_test_cleanup
}
_register_cleanup _cleanup_149

_cifs_test_socket_snapshot > "$tmp.before"
_cifs_test_mount 'vers=3.1.1,nomultichannel,cache=none,echo_interval=1,hard'
_cifs_test_socket_snapshot > "$tmp.after"
_cifs_test_new_socket "$tmp.before" "$tmp.after"
_cifs_test_workspace "$CIFS_TEST_MNT"
echo hostname-reconnect > "$CIFS_TEST_WORK/data" || _fail "write baseline"
[ "$(cat "$CIFS_TEST_WORK/data")" = hostname-reconnect ] || _fail "read baseline"

changed=true
timeout --kill-after=5s 20 "$CIFS149_DNS_HOOK" switch "$host" "$CIFS149_SECOND_IP" >> "$seqres.full" 2>&1 || _fail "switch dedicated DNS fixture"
resolved=$(getent ahostsv4 "$host" | awk '{print $1}' | sort -u)
[ "$resolved" = "$CIFS149_SECOND_IP" ] || _fail "DNS fixture did not switch exclusively to the second address"
_cifs_test_disconnect >> "$seqres.full" 2>&1 || _fail "disconnect owned hostname socket"
timeout --kill-after=5s 45 cat "$CIFS_TEST_WORK/data" > "$tmp.read" || _fail "read after hostname reconnect"
printf 'hostname-reconnect\n' > "$tmp.expected"
cmp "$tmp.expected" "$tmp.read" || _fail "reconnected data mismatch"
_cifs_test_socket_snapshot > "$tmp.reconnected"
connection=$(comm -13 "$tmp.before" "$tmp.reconnected")
[ "$(printf '%s\n' "$connection" | wc -l)" -eq 1 ] || _fail "reconnected socket is ambiguous"
read -r local_endpoint peer_endpoint <<< "$connection"
[ "$peer_endpoint" = "$CIFS149_SECOND_IP:445" ] || _fail "reconnect did not use the new address"

echo "hostname re-resolve reconnect OK"
status=0
exit

