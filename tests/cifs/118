#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: SMB signing enabled with -o sign
#
# Behavior under test
# - Mount with -o sign and verify that DebugData for our connection shows
#   signing enabled. If DebugData lacks a recognizable signing indicator,
#   skip with diagnostics.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_share_from_unc() { echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#'; }
_unc_windows() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "\\\\\\\\%s\\\\%s" "$h" "$s"; }

HOST=$(_host_from_unc "$TEST_DEV")
SHARE=$(_share_from_unc "$TEST_DEV")
[ -n "$HOST" ] || _notrun "could not derive host"

_dd_signing_on_for_host()
{
    local host="$1" snap
    snap=$(cat /proc/fs/cifs/DebugData 2>/dev/null) || return 2
    echo "$snap" >> $seqres.full
    # Look for signing state in the server block containing our hostname.
    # Kernel 6.x format: "Dialect 0x311 signed" or "SessionId: 0xNNN signed"
    # Older format: "Signing: on/yes/true/enabled"
    awk -v host="$host" '
        BEGIN { found=0; inblock=0; host_lc=tolower(host) }
        /ConnectionId:/ || /^[[:space:]]*Servers:/ { inblock=0 }
        { line_lc = tolower($0) }
        /ConnectionId:/ && index(line_lc, host_lc) > 0 { inblock=1; next }
        inblock == 1 && /ConnectionId:/ { inblock=0; next }
        inblock == 1 {
            if (line_lc ~ /signed/) { found=1 }
            if (line_lc ~ /sign/ && line_lc ~ /(on|yes|true|enable)/) { found=1 }
        }
        END { if (found) print 1; else print "" }
    ' <<< "$snap"
}

_register_cleanup "_test_unmount >/dev/null 2>&1; rm -rf \"$TEST_DIR/cifs118.$$.w\" >/dev/null 2>&1"

_test_unmount > /dev/null 2>&1
_do "_test_mount -o sign" || _fail "mount with -o sign failed"

# light I/O
mkdir -p "$TEST_DIR/cifs118.$$.w" 2>>$seqres.full || true
echo 1 > "$TEST_DIR/cifs118.$$.w/poke" 2>>$seqres.full || true

tries=15
state=""
while [ $tries -gt 0 ]; do
    state=$(_dd_signing_on_for_host "$HOST")
    [ -n "$state" ] && break
    tries=$((tries-1)); sleep 0.2
done

[ -n "$state" ] || _notrun "DebugData lacks signing state for \\$HOST\\$SHARE"

if [ "$state" -eq 1 ]; then
    echo "SMB signing enabled OK"
else
    _notrun "server/share did not enable signing for \\$HOST\\$SHARE (requested with -o sign)"
fi

status=0
exit
