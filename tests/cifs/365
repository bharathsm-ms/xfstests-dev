#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: Invalid mount options — error path coverage for fs_context.c
# Exercises: smb3_parse_opt error paths, fs_context.c validation

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$CIFS_CRED_FILE" ] || _notrun "CIFS_CRED_FILE not set"

. ./common/cifs_test
_cifs_test_init
_cifs_test_mount 'vers=3.1.1'
_cifs_test_workspace "$CIFS_TEST_MNT"
echo positive-control > "$CIFS_TEST_WORK/data" || _fail "positive-control write"
[ "$(cat "$CIFS_TEST_WORK/data")" = positive-control ] || _fail "positive-control read"

# Test invalid options — each should fail cleanly
for opts in \
	"vers=9.9" \
	"vers=0" \
	"cache=bogus" \
	"sec=invalid_auth" \
	"rsize=notanumber" \
	"wsize=notanumber" \
	"actimeo=notanumber" \
	"port=notanumber" \
	"max_credits=notanumber" \
	"closetimeo=notanumber" \
	"echo_interval=notanumber" \
	"snapshot=abc" \
	"max_channels=notanumber" \
	"blocksize=0" \
	"blocksize=4294967295" \
	"rasize=0" \
	"rasize=4294967295" \
	"acregmax=4294967295" \
	"acdirmax=4294967295" \
	"actimeo=4294967295" \
	"closetimeo=4294967295" \
	"echo_interval=0" \
	"echo_interval=4294967295" \
	"max_credits=19" \
	"max_credits=60001" \
	"max_channels=0" \
	"max_channels=4294967295" \
	"max_cached_dirs=0" \
	"handletimeout=4294967295" \
	"upcall_target=bogus" \
	"reparse=bogus" \
	"symlink=bogus" \
	"symlinkroot=relative" \
	"srcaddr=invalid-address" \
	"iocharset=$(printf '%65s' '' | tr ' ' x)" \
	"persistenthandles,nopersistenthandles" \
	"nopersistenthandles,persistenthandles" \
	"persistenthandles,resilienthandles" \
	"resilienthandles,persistenthandles" \
	"multiuser,upcall_target=mount" \
	"multichannel,max_channels=1" \
	"nomultichannel,max_channels=2"; do
	echo "trying: $opts" >> "$seqres.full"
	_cifs_test_mount_rejected "credentials=$CIFS_CRED_FILE,$opts" "$TEST_DEV" \
		'bad|invalid|unknown|mount error\(22\)'
	[ "$(cat "$CIFS_TEST_WORK/data")" = positive-control ] || _fail "negative mount changed control data"
done

for opts in noposixpaths sec=krb5 multiuser username=cifs-invalid-user \
	domain=CIFS_INVALID_DOMAIN iocharset=ascii nounicode nbsessinit; do
	echo "reject remount: $opts" >> "$seqres.full"
	timeout --kill-after=5s 30 mount -o "remount,credentials=$CIFS_CRED_FILE,$opts" \
		"$CIFS_TEST_MNT" > "$tmp.remount" 2>&1
	result=$?
	cat "$tmp.remount" >> "$seqres.full"
	[ "$result" -ne 0 ] || _fail "immutable remount option accepted: $opts"
	[ "$result" -ne 124 ] && [ "$result" -ne 137 ] || _fail "negative remount timed out"
	grep -Eiq 'mount error\(22\)|Invalid argument' "$tmp.remount" ||
		_fail "remount failed for an unexpected reason: $opts"
	[ "$(cat "$CIFS_TEST_WORK/data")" = positive-control ] || _fail "rejected remount changed data"
done

echo "invalid mount options error paths OK"
status=0
exit
