#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: symlink loop → ELOOP
#
# Negative test: creating a symlink loop (a→b→a) then stat'ing either
# should return ELOOP (errno 40), not hang or crash.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

W="$TEST_DIR/cifs297.$$"
_register_cleanup "rm -rf '$W' >/dev/null 2>&1 || true"
mkdir -p "$W" || _fail "mkdir workspace"

# Create symlink loop: a → b, b → a
ln -s "$W/link_b" "$W/link_a" 2>>"$seqres.full" || _notrun "symlink creation failed"
ln -s "$W/link_a" "$W/link_b" 2>>"$seqres.full" || _notrun "symlink creation failed"

# Stat through the loop should fail with ELOOP
# Note: GNU stat command falls back to lstat when stat fails, masking ELOOP.
# Use python3 os.stat() to get the real syscall result.
stat_result=$(python3 -c "
import os, sys, errno
try:
    os.stat('$W/link_a')
    print('OK')
except OSError as e:
    print(f'ERR:{e.errno}:{os.strerror(e.errno)}')
" 2>>"$seqres.full")
echo "stat link_a: result='$stat_result'" >> "$seqres.full"

case "$stat_result" in
    ERR:40:*)
        echo "symlink loop ELOOP correctly returned" >> "$seqres.full"
        ;;
    ERR:2:*)
        # ENOENT — some CIFS mfsymlinks implementations return this
        echo "symlink loop returned ENOENT (acceptable on CIFS mfsymlinks)" >> "$seqres.full"
        ;;
    OK)
        # stat succeeded — on CIFS with mfsymlinks, the kernel may not follow
        # the symlink chain during stat() because mfsymlinks are stored as
        # regular files with special content. The server returns file metadata
        # directly without resolving the chain.
        # Check if the kernel at least reports it as a symlink
        ftype=$(python3 -c "
import os, stat
st = os.lstat('$W/link_a')
print('symlink' if stat.S_ISLNK(st.st_mode) else 'other')
" 2>/dev/null)
        if [ "$ftype" = "symlink" ]; then
            echo "symlink loop: stat succeeded (mfsymlinks doesn't follow chain) — lstat shows symlink" >> "$seqres.full"
        else
            _fail "stat on symlink loop succeeded and it's not even a symlink"
        fi
        ;;
    *)
        _fail "symlink loop: unexpected result: $stat_result"
        ;;
esac

# Also test cat through the loop
err2=$(cat "$W/link_a" 2>&1)
rc2=$?
echo "cat link_a: rc=$rc2 err='$err2'" >> "$seqres.full"
[ $rc2 -ne 0 ] || _fail "cat through symlink loop succeeded"

echo "symlink loop negative test OK"

status=0
exit
