#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: lease stress under closetimeo=30 across two mounts
#
# Scenario:
#   - Remount primary share with closetimeo=30 (and actimeo=0 for fresher metadata) to
#     encourage delayed close caching behavior.
#   - Mount a secondary client (second mount) also with closetimeo=30, actimeo=0.
#   - Create a working directory with a set of small files (default 50, override CIFS_LEASE_STRESS_FILES).
#   - Launch multiple worker processes on BOTH mounts performing rapid mixed operations:
#       * small reads (cat first bytes)
#       * small appends (echo >> file)
#       * rename file -> file.tmp -> file
#       * delete + recreate (forcing lease breaks)
#   - Each operation is individually timed; any single op exceeding the per-op
#     threshold (default 2000 ms, env CIFS_LEASE_OP_MAX_MS) FAILs the test.
#   - Run for a bounded duration (default 15s, env CIFS_LEASE_STRESS_DURATION).
#
# Expectations:
#   - Despite closetimeo=30 and concurrent lease breaks, operations complete quickly (<2s).
#   - No hangs or excessive delays caused by lease break handling.
#
# Skip conditions:
#   - Not CIFS, missing TEST_DIR.
#   - Leasing unsupported (cap bit 0x2).
#   - Cannot remount with closetimeo=30.
#
# Output: single success line; detailed timing/slow ops in $seqres.full.

. ./common/preamble
. ./common/rc
_begin_fstest auto stress

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/DebugData ] || _notrun "no DebugData"

# Capability check for leasing (bit1 0x2)
host=$(echo "$TEST_DEV" | sed -E 's#^//([^/]+)/.*#\1#')
[ -n "$host" ] || _notrun "parse host failed"
cap_line=$(awk -v h="$host" 'tolower($0) ~ h {t=1} t && /Server capabilities:/ {print; exit}' /proc/fs/cifs/DebugData)
[ -n "$cap_line" ] || _notrun "no capabilities line"
cap_hex=$(echo "$cap_line" | sed -n 's/.*Server capabilities:[[:space:]]*0x\([0-9a-fA-F]\+\).*/\1/p')
[ -n "$cap_hex" ] || _notrun "parse caps failed"
cap_val=$((0x$cap_hex))
if [ $((cap_val & 0x2)) -eq 0 ]; then _notrun "leasing unsupported"; fi
echo "cifs171: server caps=0x$cap_hex" >> $seqres.full

# Preserve original mount options
mline=$(awk -v mnt="$TEST_DIR" '$2==mnt {print; exit}' /proc/mounts)
[ -n "$mline" ] || _notrun "mount entry not found"
orig_opts=$(echo "$mline" | awk '{print $4}')
base_opts=$(echo "${MOUNT_OPTIONS:-}" | sed -e 's/^[[:space:]]*-o[[:space:]]*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
[ -z "$base_opts" ] && base_opts=$orig_opts

# Ensure closetimeo=30, actimeo=0 present
want_opts="closetimeo=30,actimeo=0"
remount_opts=$want_opts
IFS=',' read -r -a cur_arr <<< "$base_opts"
for o in "${cur_arr[@]}"; do
    case "$o" in
        closetimeo=*|actimeo=*) ;; # override by want_opts
        *) remount_opts+=",$o" ;;
    esac
done

if [ "$(id -u)" != 0 ]; then _notrun "root required to remount with closetimeo=30"; fi
_test_unmount >/dev/null 2>&1 || _notrun "cannot unmount"
if ! _do "_test_mount -o $remount_opts"; then
    _notrun "remount with closetimeo=30 failed"
fi
_register_cleanup "_test_unmount >/dev/null 2>&1; _do '_test_mount -o $base_opts' >/dev/null 2>&1 || true"
echo "cifs171: remounted opts=$remount_opts" >> $seqres.full

# Secondary mount
MNT2=$(mktemp -d /tmp/cifs171.sec.XXXXXX)
if ! mount -t cifs "$TEST_DEV" "$MNT2" -o "$remount_opts" 2>>$seqres.full; then
    rmdir "$MNT2"; _notrun "secondary mount failed"
fi
_register_cleanup "umount $MNT2 >/dev/null 2>&1 || true; rmdir $MNT2 >/dev/null 2>&1 || true"

FILES=${CIFS_LEASE_STRESS_FILES:-50}
DUR=${CIFS_LEASE_STRESS_DURATION:-15}
# Per-op max duration (ms) before counting as SLOW (not immediate fail)
OPMAX=${CIFS_LEASE_OP_MAX_MS:-4000}
# Allowed number of slow operations across lifetime of each worker before FAIL
SLOW_TOL=${CIFS_LEASE_STRESS_SLOW_TOL:-3}
# Allowed transient rc failures per worker before FAIL
RC_TOL=${CIFS_LEASE_STRESS_RC_TOL:-2}
WPRIMARY=${CIFS_LEASE_STRESS_PWORKERS:-3}
WSECONDARY=${CIFS_LEASE_STRESS_SWORKERS:-3}

WROOT="$TEST_DIR/cifs171.work"
SROOT="$MNT2/cifs171.work"
rm -rf "$WROOT" "$SROOT" 2>/dev/null || true
mkdir -p "$WROOT" "$SROOT" || _fail "mkdir work roots"

echo "cifs171: FILES=$FILES DUR=$DUR OP_MAX_MS=$OPMAX SLOW_TOL=$SLOW_TOL RC_TOL=$RC_TOL workers P=$WPRIMARY S=$WSECONDARY" >> $seqres.full

# Seed identical files (small content) on primary; ensure presence on secondary path.
for i in $(seq 1 $FILES); do
    f="$WROOT/f$i"
    echo "seed$i" > "$f" || _fail "seed $f"
done

# Worker function: performs random ops; record slow operations.
worker() {
    local root=$1; local tag=$2; local end_ts=$3; local tmp rc op start_ns end_ns dur_ms fname alt slow=0 rc_fail=0
    while [ $(date +%s) -lt $end_ts ]; do
        fname="$root/f$(( (RANDOM % FILES) + 1 ))"
        op=$((RANDOM % 4))
        start_ns=$(date +%s%N)
        case $op in
            0) head -c 16 "$fname" > /dev/null 2>&1 ; rc=$? ;;
            1) printf "x" >> "$fname" 2>/dev/null ; rc=$? ;;
            2) alt="$fname.tmp$BASHPID"; mv "$fname" "$alt" 2>/dev/null && mv "$alt" "$fname" 2>/dev/null; rc=$? ;;
            3) rm -f "$fname" 2>/dev/null; echo "r$RANDOM" > "$fname" 2>/dev/null; rc=$? ;;
        esac
        end_ns=$(date +%s%N)
        dur_ms=$(( (end_ns - start_ns)/1000000 ))
        if [ $rc -ne 0 ]; then
            # Attempt remediation for race losses (file deleted/renamed by other worker)
            case $op in
                0|1) echo "heal" > "$fname" 2>/dev/null; rc=$? ;;
                2) alt="$fname.tmp$BASHPID"; echo "heal" > "$fname" 2>/dev/null && mv "$fname" "$alt" 2>/dev/null && mv "$alt" "$fname" 2>/dev/null; rc=$? ;;
                3) echo "heal" > "$fname" 2>/dev/null; rc=$? ;;
            esac
            if [ $rc -ne 0 ]; then
                rc_fail=$((rc_fail+1))
                echo "RC_FAIL tag=$tag op=$op file=${fname##*/} rc=$rc dur_ms=$dur_ms rc_fail=$rc_fail" >> $seqres.full
                if [ $rc_fail -gt $RC_TOL ]; then
                    echo "FAIL_RC_EXCEEDED tag=$tag rc_fail=$rc_fail" >> $seqres.full
                    echo FAIL > "$WROOT/FAIL"; return 1
                fi
            fi
        fi
        if [ $dur_ms -gt $OPMAX ]; then
            slow=$((slow+1))
            echo "SLOW_OP tag=$tag op=$op file=${fname##*/} dur_ms=$dur_ms slow_count=$slow" >> $seqres.full
            if [ $slow -gt $SLOW_TOL ]; then
                echo "FAIL_SLOW_EXCEEDED tag=$tag slow_count=$slow" >> $seqres.full
                echo FAIL > "$WROOT/FAIL"; return 1
            fi
        fi
    done
    echo "DONE tag=$tag slow_final=$slow rc_fail_final=$rc_fail" >> $seqres.full
}

end_time=$(( $(date +%s) + DUR ))

# Launch workers
pids=""
for i in $(seq 1 $WPRIMARY); do
    worker "$WROOT" "P$i" $end_time & pids+=" $!"
done
for i in $(seq 1 $WSECONDARY); do
    worker "$SROOT" "S$i" $end_time & pids+=" $!"
done

# Monitor
while :; do
    fail_flag=0
    if [ -f "$WROOT/FAIL" ]; then fail_flag=1; fi
    alive=0
    for p in $pids; do if kill -0 $p 2>/dev/null; then alive=1; fi; done
    [ $fail_flag -eq 1 ] && { for p in $pids; do kill $p 2>/dev/null || true; done; break; }
    [ $alive -eq 0 ] && break
    sleep 0.5
done

# Wait cleanup
worker_failed=0
for p in $pids; do wait "$p" 2>/dev/null || worker_failed=1; done

if [ "$worker_failed" -ne 0 ] || [ -f "$WROOT/FAIL" ]; then
    _fail "operation exceeded ${OPMAX}ms or rc failure (see $seqres.full)"
fi

# Basic activity sanity: ensure at least some operations recorded by checking size growth or logs.
ops_count=$(grep -c '^DONE tag=' "$seqres.full" 2>/dev/null || true)
[ "$ops_count" -ge 1 ] || _fail "no worker completion markers"
slow_total=$(grep -c '^SLOW_OP ' "$seqres.full" 2>/dev/null || true)
rc_fail_total=$(grep -c '^RC_FAIL ' "$seqres.full" 2>/dev/null || true)
echo "cifs171: summary workers=$ops_count slow_ops=$slow_total rc_fail_ops=$rc_fail_total tol_slow=$SLOW_TOL tol_rc=$RC_TOL opmax_ms=$OPMAX" >> $seqres.full

echo "Lease stress closetimeo=30 OK"
status=0; exit
