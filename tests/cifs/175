#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: mount.cifs retries resolved server addresses after connection refusal

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
for required in unshare python3 iptables; do
    command -v "$required" >/dev/null 2>&1 || _notrun "$required required"
done
[ -r /etc/gai.conf ] || _notrun "resolver address-policy file unavailable"

host=${TEST_DEV#//}
host=${host%%/*}
REALIP=$(getent ahostsv4 "$host" | awk '{print $1; exit}')
[ -n "$REALIP" ] || _notrun "resolve IPv4 failed"
BAD=127.0.0.2
[ "$BAD" != "$REALIP" ] || BAD=127.0.0.3
ALIAS="cifs175-$$.invalid"

base_opts=$(echo "${MOUNT_OPTIONS:-}" | sed -e 's/^[[:space:]]*-o[[:space:]]*//')
case ",$base_opts," in
    *,sec=krb5,*|*,sec=krb5i,*) _notrun "private hostname fixture requires password authentication" ;;
esac
base_opts=$(printf '%s\n' "$base_opts" | awk -F, '{
    for (field=1; field<=NF; field++) {
        if ($field ~ /^(ip|addr|port)=/ || $field=="nosharesock") continue
        options=options (options ? "," : "") $field
    }
    print options
}')

REJECTED=false
reject_rule=(-d "$BAD" -p tcp -m multiport --dports "445,139" -m comment --comment "cifs175.$$" -j REJECT --reject-with tcp-reset)
_cleanup_175()
{
    if $REJECTED; then
        iptables -D OUTPUT "${reject_rule[@]}" 2>> "$seqres.full" || status=1
        REJECTED=false
    fi
    _cleanup
}
_register_cleanup _cleanup_175
iptables -I OUTPUT "${reject_rule[@]}" 2>> "$seqres.full" || _notrun "iptables reject rule unavailable"
REJECTED=true

unshare --mount --propagation private python3 - "$TEST_DEV" "$ALIAS" "$BAD" "$REALIP" "$base_opts" "$seqres.full" <<'PY'
import os
import pathlib
import socket
import subprocess
import sys
import tempfile

device, alias, bad, real, options, logfile = sys.argv[1:]
share = device.removeprefix('//').split('/', 1)[1]
assert os.readlink('/proc/self/ns/mnt') != os.readlink('/proc/1/ns/mnt')
with tempfile.TemporaryDirectory(prefix='cifs175.') as directory:
    root = pathlib.Path(directory)
    hosts = root / 'hosts'
    hosts.write_text(pathlib.Path('/etc/hosts').read_text() + f'\n{bad} {alias}\n{real} {alias}\n')
    precedence = root / 'gai.conf'
    precedence.write_text(f'precedence ::ffff:{bad}/128 100\nprecedence ::/0 40\n')
    mountpoint = root / 'mnt'
    mountpoint.mkdir()
    mounted = False
    precedence_mounted = False
    subprocess.run(['mount', '--bind', str(hosts), '/etc/hosts'], check=True)
    try:
        subprocess.run(['mount', '--bind', str(precedence), '/etc/gai.conf'], check=True)
        precedence_mounted = True
        addresses = list(dict.fromkeys(item[4][0] for item in socket.getaddrinfo(alias, 445, socket.AF_INET, socket.SOCK_STREAM)))
        if addresses != [bad, real]:
            print('resolver does not preserve the required bad-first address order')
            sys.exit(77)
        result = subprocess.run(['mount', '-t', 'cifs', f'//{alias}/{share}', str(mountpoint), '-o', f'{options},nosharesock'], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
        with open(logfile, 'a') as log:
            log.write(result.stdout + result.stderr)
        if result.returncode:
            raise RuntimeError(f'mount failed with status {result.returncode}')
        mounted = True
        if f'could not connect to {bad}' not in result.stderr:
            raise RuntimeError('no evidence the helper attempted the first address')
        payload = b'cifs175 address fallback\n'
        target = mountpoint / alias
        try:
            with target.open('wb') as output:
                output.write(payload)
                output.flush()
                os.fsync(output.fileno())
            if target.read_bytes() != payload:
                raise RuntimeError('fallback mount data mismatch')
        finally:
            target.unlink(missing_ok=True)
        with open(logfile, 'a') as log:
            log.write(f'cifs175: refused {bad}, mounted through the only other resolved address {real}; I/O verified\n')
    finally:
        if mounted:
            subprocess.run(['umount', str(mountpoint)], check=True, timeout=30)
        if precedence_mounted:
            subprocess.run(['umount', '/etc/gai.conf'], check=True)
        subprocess.run(['umount', '/etc/hosts'], check=True)
PY
result=$?
[ "$result" -ne 77 ] || _notrun "resolver cannot supply the required bad-first address fixture"
[ "$result" -eq 0 ] || _fail "resolved-address failover failed"

echo "Multi-address IP failover OK"
status=0; exit
