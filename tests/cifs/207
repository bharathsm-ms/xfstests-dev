#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: persistent/durable handle survives reconnect
#
# Keep a file descriptor open, force a TCP reconnect window, and validate that
# the open_files entry for that fd has a non-zero persistent fid both before
# and after reconnect. Skip if backend does not expose persistent handles.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/open_files ] || _notrun "open_files unavailable"
command -v iptables >/dev/null 2>&1 || _notrun "iptables required"

host=$(echo "$TEST_DEV" | sed -E 's#^//([^/]+)/.*#\1#')
[ -n "$host" ] || _notrun "parse host failed"
server_ip=$(getent ahostsv4 "$host" | awk '{print $1; exit}')
[ -n "$server_ip" ] || _notrun "resolve IPv4 failed"

DIR=$(mktemp -d "$TEST_DIR/cifs207.XXXXXX") || _fail "mkdir"
FILE="$DIR/holdfile.${DIR##*/}"
HOLDER_PID=""
OUTPUT_DROPPED=false
INPUT_DROPPED=false
output_rule=(-d "$server_ip" -p tcp --dport 445 -m comment --comment "${DIR##*/}" -j DROP)
input_rule=(-s "$server_ip" -p tcp --sport 445 -m comment --comment "${DIR##*/}" -j DROP)
_cleanup_207() {
    $OUTPUT_DROPPED && iptables -D OUTPUT "${output_rule[@]}" 2>/dev/null
    $INPUT_DROPPED && iptables -D INPUT "${input_rule[@]}" 2>/dev/null
    if [ -n "$HOLDER_PID" ]; then
        kill "$HOLDER_PID" >/dev/null 2>&1 || true
        wait "$HOLDER_PID" 2>/dev/null || true
    fi
    rm -rf "$DIR" >>$seqres.full 2>&1 || status=1
    _cleanup
}
_register_cleanup _cleanup_207

# Holder keeps fd 9 open and appends periodically.
(
    trap - EXIT HUP INT QUIT TERM
    exec 9>>"$FILE" || exit 1
    i=0
    while true; do
        i=$((i+1))
        printf "tick-%d\n" "$i" >&9 || exit 2
        sleep 0.2 9>&-
    done
) >>$seqres.full 2>&1 &
HOLDER_PID=$!

parse_pfid_for_pid_file() {
    awk -v pid="$1" -v file="$2" '
        $6 == pid && $8 == file {
            print $3
            exit
        }
    ' /proc/fs/cifs/open_files
}

wait_pfid() {
    local pid="$1"
    local file="$2"
    local base
    base=$(basename "$file")
    local tries=${3:-50}
    local pfid=""
    while [ "$tries" -gt 0 ]; do
        kill -0 "$pid" 2>/dev/null || return 1
        pfid=$(parse_pfid_for_pid_file "$pid" "$base")
        if [ -n "$pfid" ]; then
            echo "$pfid"
            return 0
        fi
        sleep 0.2
        tries=$((tries-1))
    done
    return 1
}

is_zero_pfid() {
    local v=$(echo "$1" | tr 'A-Z' 'a-z')
    [ "$v" = "0" ] || [ "$v" = "0x0" ] || [ "$v" = "0000000000000000" ] || [ "$v" = "0x0000000000000000" ]
}

PFID1=$(wait_pfid "$HOLDER_PID" "$FILE" 60) || _fail "holder failed to expose its open_files entry"
if is_zero_pfid "$PFID1"; then
    _notrun "persistent/durable handle not exposed"
fi

echo "cifs207: pre-reconnect persistent_fid=$PFID1" >>$seqres.full

iptables -I OUTPUT "${output_rule[@]}" >>$seqres.full 2>&1 || _notrun "iptables insert failed"
OUTPUT_DROPPED=true
iptables -I INPUT "${input_rule[@]}" >>$seqres.full 2>&1 || _notrun "iptables insert failed"
INPUT_DROPPED=true
sleep 3
iptables -D OUTPUT "${output_rule[@]}" >>$seqres.full 2>&1 || _fail "remove OUTPUT rule failed"
OUTPUT_DROPPED=false
iptables -D INPUT "${input_rule[@]}" >>$seqres.full 2>&1 || _fail "remove INPUT rule failed"
INPUT_DROPPED=false
# Allow time for the kernel to recover from stale session state
# so that further mounts can succeed.
sleep 2

kill -0 $HOLDER_PID 2>/dev/null || _fail "holder died during reconnect"

PFID2=$(wait_pfid "$HOLDER_PID" "$FILE" 80) || _fail "missing open_files entry after reconnect"
is_zero_pfid "$PFID2" && _fail "persistent fid became zero after reconnect"

echo "cifs207: post-reconnect persistent_fid=$PFID2" >>$seqres.full

kill $HOLDER_PID >/dev/null 2>&1 || true
wait "$HOLDER_PID" 2>/dev/null || true
HOLDER_PID=""

echo "persistent/durable handle reconnect OK"
status=0
exit
