#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: verify max_channels=2 is honored when multichannel is requested
#
# Behavior under test
# - Mount with -o multichannel,max_channels=2 and verify the client reports
#   exactly 2 allocated channels for the server connection in DebugData.
# - Also verify there are at least 2 TCP sockets to the server.
#
# Skip policy
# - If DebugData lacks interfaces for this host or shows <2 channels repeatedly,
#   skip (server/kernel may not support multichannel).

. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_debug

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_share_from_unc() { echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#'; }
_unc_windows() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "\\\\%s\\%s" "$h" "$s"; }

HOST=$(_host_from_unc "$TEST_DEV")
UNCW=$(_unc_windows "$TEST_DEV")
[ -n "$HOST" ] || _notrun "could not derive host"

command -v ss >/dev/null 2>&1 || _notrun "ss required"
[ -r /proc/fs/cifs/DebugData ] || _notrun "DebugData unavailable"
. ./common/cifs_test
_cifs_test_init

# Request exactly two channels
_cifs_test_mount_connection 'vers=3.1.1,multichannel,max_channels=2'
_cifs_test_workspace "$CIFS_TEST_MNT"

# Trigger activity
dd if=/dev/urandom of="$tmp.expected" bs=1M count=4 status=none || _fail "prepare expected data"
dd if="$tmp.expected" of="$CIFS_TEST_WORK/data" bs=1M oflag=direct conv=fsync status=none 2>>$seqres.full || _fail "activation I/O failed"
cmp "$tmp.expected" "$CIFS_TEST_WORK/data" || _fail "activation data mismatch"

# Poll for DebugData sum
_cifs_wait_multichannel "$TEST_DEV" 2 "$CIFS_TEST_CONNECTION"
sum=$CIFS_CHANNELS

if [ "$sum" -ne 2 ]; then
    _fail "expected DebugData allocated channels sum=2, got $sum"
fi

# Also check sockets
tries=20
sc=0
while [ $tries -gt 0 ]; do
    sc=$(_cifs_tcp_connections "$HOST" "$CIFS_INTERFACE_IPS")
    echo "sockets: count=$sc (tries=$tries)" >> $seqres.full
    [ "$sc" -ge 2 ] && break
    tries=$((tries-1)); sleep 0.3
done

[ "$sc" -ge 2 ] || _fail "expected >=2 TCP sockets to $HOST, got $sc"
if [ "$sc" -lt "$sum" ]; then
    _fail "TCP sockets ($sc) < DebugData channels ($sum)"
fi

echo "Max channels honored (2) OK"

status=0
exit
