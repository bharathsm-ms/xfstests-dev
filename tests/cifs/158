#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: multiuser isolation basic
. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_test
_cifs_test_init
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -r "${CIFS_CRED_FILE2:-}" ] || _notrun "CIFS_CRED_FILE2 required for a distinct server account"
command -v python3 >/dev/null || _notrun "python3 required"

primary_credentials=$CIFS_CRED_FILE
_cifs_test_mount 'vers=3.1.1,posix,multiuser,sec=ntlmssp,cache=none' "$TEST_DEV" 'SMB3 POSIX modes required'
_cifs_test_workspace "$CIFS_TEST_MNT"
primary_work=$CIFS_TEST_WORK
relative=${primary_work##*/}
chmod 0711 "$primary_work" || _fail "set traversable private workspace"
(umask 077; echo secret > "$primary_work/private") || _fail "write private user1 file"
chmod 0600 "$primary_work/private" || _fail "set private user1 file mode"
[ "$(stat -c %a "$primary_work/private")" = 600 ] || _fail "user1 file is not private"
[ "$(cat "$primary_work/private")" = secret ] || _fail "read user1 file"

CIFS_CRED_FILE=$CIFS_CRED_FILE2
_cifs_test_mount 'vers=3.1.1,posix,multiuser,sec=ntlmssp,cache=none' "$TEST_DEV" 'SMB3 POSIX modes required'
CIFS_CRED_FILE=$primary_credentials
_cifs_test_workspace "$CIFS_TEST_MNT"
echo control > "$CIFS_TEST_WORK/control" || _fail "write user2 control"
[ "$(cat "$CIFS_TEST_WORK/control")" = control ] || _fail "read user2 control"
python3 - "$CIFS_TEST_MNT/$relative/private" >> "$seqres.full" 2>&1 <<'PY'
import errno, pathlib, sys
try:
  pathlib.Path(sys.argv[1]).read_bytes()
except OSError as error:
  assert error.errno == errno.EACCES, 'unexpected access failure'
else:
  raise AssertionError('user2 accessed user1 private file')
PY
[ "$?" -eq 0 ] || _fail "user2 private-file isolation failed"
[ "$(cat "$primary_work/private")" = secret ] || _fail "private data changed"

echo "multiuser isolation OK"
status=0; exit
