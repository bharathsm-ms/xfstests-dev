#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: strictsync ensures flush on fsync
. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_debug
. ./common/cifs_test
_cifs_test_init
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -r /proc/fs/cifs/Stats ] || _notrun "no Stats"
command -v python3 >/dev/null 2>&1 || _notrun "requires python3"

_cifs_test_mount 'strictsync'
_cifs_test_workspace "$CIFS_TEST_MNT"

stat_before=$(_cifs_stat "$TEST_DEV" "Flushes:") || _notrun "no flush counter for test share"
python3 - "$CIFS_TEST_WORK/strictsync_test" >> "$seqres.full" 2>&1 <<'PY'
import os
import sys

with open(sys.argv[1], 'wb') as target:
	target.write(b'data\n')
	target.flush()
	os.fsync(target.fileno())
PY
[ "$?" -eq 0 ] || _fail "strictsync write/fsync failed"
stat_after=$(_cifs_stat "$TEST_DEV" "Flushes:") || _fail "test share flush counter disappeared"
echo "cifs157: Flushes before=$stat_before after=$stat_after" >> "$seqres.full"
if [ "$stat_after" -le "$stat_before" ]; then _fail "flush counter did not increase"; fi
echo "strictsync flush OK"
status=0; exit
