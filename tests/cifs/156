#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: hard vs soft behavior on network loss
. ./common/preamble
. ./common/rc
_begin_fstest auto quick
[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ "$(id -u)" = 0 ] || _notrun "root/iptables required"
command -v iptables >/dev/null 2>&1 || _notrun "iptables required"
command -v python3 >/dev/null 2>&1 || _notrun "python3 required"

host=$(echo "$TEST_DEV" | sed -E 's#^//([^/]+)/.*#\1#')
server_ip=$(getent ahostsv4 "$host" | awk '{print $1; exit}')
[ -n "$server_ip" ] || _notrun "resolve host failed"

make_mount() {
    local dir=$1 extra=$2
	mkdir -p "$dir" || _fail "mkdir $dir"
	if ! mount -t cifs -o "$extra" "$TEST_DEV" "$dir" >>$seqres.full 2>&1; then
        _fail "mount failed for $dir"
	fi
}

HARD_MNT="/tmp/cifs156.hard.$$"; SOFT_MNT="/tmp/cifs156.soft.$$"
HARD_FILE="$HARD_MNT/cifs156.$$.hard"
SOFT_FILE="$SOFT_MNT/cifs156.$$.soft"
HP=""; SP=""
OUTPUT_DROPPED=false
INPUT_DROPPED=false
output_rule=(-d "$server_ip" -p tcp --dport 445 -m comment --comment "cifs156.$$" -j DROP)
input_rule=(-s "$server_ip" -p tcp --sport 445 -m comment --comment "cifs156.$$" -j DROP)
restore_traffic() {
    if $OUTPUT_DROPPED; then
        iptables -D OUTPUT "${output_rule[@]}" 2>> "$seqres.full" || return 1
        OUTPUT_DROPPED=false
    fi
    if $INPUT_DROPPED; then
        iptables -D INPUT "${input_rule[@]}" 2>> "$seqres.full" || return 1
        INPUT_DROPPED=false
    fi
}
cleanup_156() {
    restore_traffic || status=1
    local child
    for child in $HP $SP; do kill "$child" 2>/dev/null || true; done
    for child in $HP $SP; do wait "$child" 2>/dev/null || true; done
    HP=""; SP=""
    rm -f "$HARD_FILE" "$SOFT_FILE" 2>> "$seqres.full" || status=1
	umount "$HARD_MNT" >/dev/null 2>&1 || true
	umount "$SOFT_MNT" >/dev/null 2>&1 || true
	rmdir "$HARD_MNT" "$SOFT_MNT" >/dev/null 2>&1 || true
    _cleanup
}
_register_cleanup cleanup_156

# Resolve credentials: prefer credentials file, then CIFS_USER/CIFS_PASS, then
# parse credentials= from MOUNT_OPTIONS, then inline username=/password= from
# MOUNT_OPTIONS.
_resolve_cifs_creds() {
    # 1. Explicit credentials file
    if [ -n "$CIFS_CRED_FILE" ] && [ -r "$CIFS_CRED_FILE" ]; then
        echo "credentials=$CIFS_CRED_FILE,noperm"; return
    fi
    # 2. Well-known credentials file
    if [ -r /root/.cifs-cred-xfstest ]; then
        echo "credentials=/root/.cifs-cred-xfstest,noperm"; return
    fi
    # 3. credentials= in MOUNT_OPTIONS
    local cred_file
    cred_file=$(echo "${MOUNT_OPTIONS:-}" | sed -n 's/.*credentials=\([^,]*\).*/\1/p')
    if [ -n "$cred_file" ] && [ -r "$cred_file" ]; then
        echo "credentials=$cred_file,noperm"; return
    fi
    # 4. CIFS_USER/CIFS_PASS environment
    if [ -n "$CIFS_USER" ] && [ -n "$CIFS_PASS" ]; then
        echo "username=$CIFS_USER,password=$CIFS_PASS,noperm"; return
    fi
    # 5. Inline username=/password= from MOUNT_OPTIONS
    local u p
    u=$(echo "${MOUNT_OPTIONS:-}" | sed -n 's/.*username=\([^,]*\).*/\1/p')
    p=$(echo "${MOUNT_OPTIONS:-}" | sed -n 's/.*password=\([^,]*\).*/\1/p')
    if [ -n "$u" ] && [ -n "$p" ]; then
        echo "username=$u,password=$p,noperm"; return
    fi
    return 1
}

base_opts=$(_resolve_cifs_creds) || _notrun "no CIFS credentials available for explicit hard/soft mounts"

# Also carry essential options from MOUNT_OPTIONS (vers=, dir_mode=, etc.)
extra_opts=$(echo "${MOUNT_OPTIONS#-o}" | sed 's/^[[:space:]]*//' | awk -F, '{
	out=""
	for(i=1;i<=NF;i++){
		if($i ~ /^(vers=|dir_mode=|file_mode=|serverino|mfsymlinks|reparse=)/) {
			out = out (out ? "," : "") $i
		}
	}
	print out
}')
[ -n "$extra_opts" ] && base_opts="$base_opts,$extra_opts"

make_mount "$HARD_MNT" "$base_opts,hard,retrans=1,echo_interval=1,cache=none,nosharesock,nomultichannel"
make_mount "$SOFT_MNT" "$base_opts,soft,retrans=1,echo_interval=1,cache=none,nosharesock,nomultichannel"

dd if=/dev/urandom of="$tmp.expected" bs=4096 count=1 status=none || _fail "prepare payload failed"
dd if="$tmp.expected" of="$HARD_FILE" bs=4096 oflag=direct conv=fsync status=none 2>>$seqres.full || _fail "seed hard file failed"
dd if="$tmp.expected" of="$SOFT_FILE" bs=4096 oflag=direct conv=fsync status=none 2>>$seqres.full || _fail "seed soft file failed"

start_reader() {
    python3 - "$1" "$tmp.expected" "$2" >> "$seqres.full" 2>&1 <<'PY' &
import pathlib
import sys

target, expected_path, result_path = sys.argv[1:]
expected = pathlib.Path(expected_path).read_bytes()
pathlib.Path(result_path + '.ready').write_text('ready')
try:
    with open(target, 'rb', buffering=0) as source:
        actual = source.read()
    result = 'ok' if actual == expected else 'mismatch'
except OSError as error:
    result = f'error:{error.errno}'
pathlib.Path(result_path).write_text(result)
PY
    reader_pid=$!
}

iptables -I OUTPUT "${output_rule[@]}" 2>> "$seqres.full" || _notrun "iptables add fail"
OUTPUT_DROPPED=true
iptables -I INPUT "${input_rule[@]}" 2>> "$seqres.full" || _notrun "iptables add fail"
INPUT_DROPPED=true

start_reader "$HARD_FILE" "$tmp.hard"
HP=$reader_pid
start_reader "$SOFT_FILE" "$tmp.soft"
SP=$reader_pid

for attempt in $(seq 1 90); do
    [ -f "$tmp.hard.ready" ] && [ -f "$tmp.soft.ready" ] && [ -s "$tmp.soft" ] && break
    sleep 0.5
done
[ -s "$tmp.soft" ] || _fail "soft read did not return within 45 seconds of network loss"
wait "$SP" || _fail "soft worker failed"
SP=""
soft_result=$(cat "$tmp.soft")
echo "cifs156: soft result during outage=$soft_result" >> "$seqres.full"
case "$soft_result" in
    error:5|error:101|error:103|error:104|error:107|error:110|error:111|error:112|error:113) ;;
    *) _fail "soft read did not return a network error ($soft_result)" ;;
esac
[ -f "$tmp.hard.ready" ] || _fail "hard worker never started"
[ ! -e "$tmp.hard" ] && kill -0 "$HP" 2>/dev/null || _fail "hard read returned during network loss"

restore_traffic || _fail "failed to restore traffic"
for attempt in $(seq 1 90); do
    [ -s "$tmp.hard" ] && break
    sleep 0.5
done
[ -s "$tmp.hard" ] || _fail "hard read did not recover within 45 seconds"
wait "$HP" || _fail "hard worker failed"
HP=""
[ "$(cat "$tmp.hard")" = "ok" ] || _fail "hard read failed or returned incorrect data after recovery"
echo "hard vs soft behavior OK"
status=0; exit
