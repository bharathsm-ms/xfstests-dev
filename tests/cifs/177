#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: SMB3 multichannel failover
#
# Behavior under test
# - Verify two channels on an isolated connection, disconnect one owned
#   socket, and verify data and channel recovery.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_debug

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
command -v ss >/dev/null 2>&1 || _notrun "ss required"
command -v python3 >/dev/null 2>&1 || _notrun "python3 required"

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_share_from_unc() { echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#'; }
_unc_windows() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "\\\\%s\\%s" "$h" "$s"; }

HOST=$(_host_from_unc "$TEST_DEV")
UNCW=$(_unc_windows "$TEST_DEV")
[ -n "$HOST" ] || _notrun "could not derive host"

command -v timeout >/dev/null 2>&1 || _notrun "timeout required"
[ -r /proc/fs/cifs/DebugData ] || _notrun "DebugData unavailable"
. ./common/cifs_test
_cifs_test_init
_cifs_test_socket_snapshot > "$tmp.sockets-before"
_cifs_test_mount_connection 'vers=3.1.1,multichannel,max_channels=2,cache=none,echo_interval=1'
_cifs_test_workspace "$CIFS_TEST_MNT"
FILE="$CIFS_TEST_WORK/data"

# Light I/O to activate connection
echo 1 > "$FILE" || _fail "create test file failed"

# Require >=2 channels
_cifs_wait_multichannel "$TEST_DEV" 2 "$CIFS_TEST_CONNECTION"

_cifs_test_socket_snapshot > "$tmp.sockets-after"
comm -13 "$tmp.sockets-before" "$tmp.sockets-after" > "$tmp.new-sockets"
[ "$(wc -l < "$tmp.new-sockets")" -eq 2 ] || _notrun "cannot isolate exactly two new channel sockets"
CIFS_TEST_SOCKET=$(head -n 1 "$tmp.new-sockets")
_cifs_test_disconnect >> "$seqres.full" 2>&1 || _fail "disconnect owned channel failed"

# Verify I/O still works
dd if=/dev/urandom of="$tmp.expected" bs=4096 count=4 status=none || _fail "prepare data failed"
timeout -k 5 30 dd if="$tmp.expected" of="$FILE" bs=4096 oflag=direct conv=fsync status=none 2>>$seqres.full || _fail "write failed after dropping channel IP"
timeout -k 5 30 dd if="$FILE" of="$tmp.actual" bs=4096 iflag=direct status=none 2>>$seqres.full || _fail "read failed after dropping channel IP"
cmp "$tmp.expected" "$tmp.actual" || _fail "data mismatch after channel failover"

_cifs_wait_multichannel "$TEST_DEV" 2 "$CIFS_TEST_CONNECTION"

echo "Multichannel failover OK"

status=0
exit
