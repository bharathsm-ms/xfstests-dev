#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: default password auth security type should be RawNTLMSSP
# Verifies that a standard username/password mount (no explicit sec=krb5/ntlmv2 override)
# reports "Security type: RawNTLMSSP" for its session in /proc/fs/cifs/DebugData.
# Accepts minor format variation (trailing 'encrypted'). Fails if another
# security type (e.g. Kerberos) unless mount opts explicitly request it.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick
. ./common/cifs_debug

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/DebugData ] || _notrun "no DebugData"

_cleanup_161()
{
  rm -f "$TEST_DIR/.cifs161.$$" >> "$seqres.full" 2>&1 || status=1
  _cleanup
}
_register_cleanup _cleanup_161

# Skip if sec= specified and not a default password case
mount_line=$(awk -v mnt="$TEST_DIR" '$2==mnt {print; exit}' /proc/mounts)
[ -n "$mount_line" ] || _notrun "mount entry not found"
opts=$(echo "$mount_line" | awk '{print $4}')
requested_opts="$TEST_FS_MOUNT_OPTS $MOUNT_OPTIONS"
if printf '%s\n' "$requested_opts" | grep -Eqi '(^|[ ,])sec=(krb5i?|ntlmv2i?|ntlmi?|none)([, ]|$)'; then
  _notrun "explicit non-default authentication requested"
fi
if ! printf '%s\n' "$opts $requested_opts" | grep -Eqi '(^|[ ,])(username|user|credentials|cred)='; then
  _notrun "no username or credentials option configured"
fi

host=$(echo "$TEST_DEV" | sed -E 's#^//([^/]+)/.*#\1#')
share=$(echo "$TEST_DEV" | sed -E 's#^//[^/]+/([^/]+).*#\1#')
[ -n "$host" ] || _notrun "parse host failed"
[ -n "$share" ] || _notrun "parse share failed"

# Touch the mount so its connection block is active in DebugData
echo x > "$TEST_DIR/.cifs161.$$" 2>>$seqres.full || _fail "activation I/O failed"
stype=$(_cifs_debug_share "$TEST_DEV" | awk '$8!="-" {print $8}' | sort -u)
[ -n "$stype" ] || _notrun "no target-session security type in DebugData"

echo "cifs161: parsed security type '$stype'" >> $seqres.full
if [ "$stype" != "RawNTLMSSP" ]; then
  _fail "expected RawNTLMSSP got $stype"
fi

echo "default password auth security type OK"
status=0
exit
